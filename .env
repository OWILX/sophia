# 1. API Endpoints and Credentials
#OPENAI_API_KEY="your-nvapi-key-here"
#OPENAI_API_BASE="https://integrate.api.nvidia.com/v1"

# 2. Aider Engine Customizations (Converted from the YAML flags)
#AIDER_MODEL="openai/deepseek-ai/deepseek-v4-flash"
#AIDER_MODEL="openai/minimaxai/minimax-m2.7"
AIDER_MODEL="openai/stepfun-ai/step-3.5-flash"
AIDER_STREAM=false
AIDER_PRETTY=false
AIDER_TIMEOUT=300

# 3. Context & Token Management
AIDER_MAP_TOKENS=2048
AIDER_CONTEXT_WINDOW=204800
#AIDER_MAX_CHAT_HISTORY_TOKENS=20000
AIDER_MAP_REFRESH="auto"

AIDER_EDIT_FORMAT="diff"
